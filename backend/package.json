{
  "name": "spacetreevisualizer-backend",
  "version": "0.1.0",
  "description": "SpaceTreeVisualizer backend: receives Peano4 tree data, serves browser",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "npm run build --workspace @spacetreevisualizer/contracts",
    "predev": "npm run build --workspace @spacetreevisualizer/contracts",
    "prewatch": "npm run build --workspace @spacetreevisualizer/contracts",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "watch": "ts-node-dev --respawn src/server.ts"
  },
  "dependencies": {
    "@spacetreevisualizer/contracts": "file:../packages/contracts",
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
